// What "player", the console's user, may do while sitting at the PC (a local, active session).
// There's no administrator password to type in, so what Marah Launcher's Settings → System needs is
// allowed here, and nothing more.

// The network: joining a new Wi-Fi network saves it for the whole system, which polkit otherwise
// reserves for an administrator (Settings → Internet runs nmcli).
polkit.addRule(function (action, subject) {
    if (action.id.indexOf("org.freedesktop.NetworkManager.") === 0 &&
        subject.user === "player" && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});

// Drives: mount a USB drive or a data disk inside the PC, and unmount and eject it (Marah
// Launcher's Drives panel runs udisksctl). The launcher offers only the player's drives, never the
// system's own parts. polkit asks an administrator for a disk inside the PC, and Marah OS has no
// administrator password to type in.
polkit.addRule(function (action, subject) {
    var drives = [
        "org.freedesktop.udisks2.filesystem-mount",
        "org.freedesktop.udisks2.filesystem-mount-system",
        "org.freedesktop.udisks2.eject-media",
        "org.freedesktop.udisks2.power-off-drive",
    ];
    if (drives.indexOf(action.id) >= 0 &&
        subject.user === "player" && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});

// "Check now" for system updates: start the update service instead of waiting for its daily run
// (`systemctl start marah-os-update.service`). Only starting, and only that unit.
polkit.addRule(function (action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "marah-os-update.service" &&
        action.lookup("verb") === "start" &&
        subject.user === "player" && subject.local && subject.active) {
        return polkit.Result.YES;
    }
});
